FROM oven/bun:latest AS builder
WORKDIR /app

# Build tools needed by node-gyp to compile @serialport/bindings-cpp native addon
RUN apt-get update -y && apt-get install -y python3 make g++ --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

FROM node:22-slim AS runner
WORKDIR /app

# udev provides `udevadm`, which @serialport/bindings-cpp shells out to on
# Linux to list serial ports (SerialPort.list()); without it the port list
# request fails.
RUN apt-get update -y && apt-get install -y udev --no-install-recommends && rm -rf /var/lib/apt/lists/*

# node:22-slim bundles a global npm install we never use (build happens via
# bun in the builder stage; CMD runs node directly). npm's own internal deps
# (picomatch, @sigstore/bundle) show up as CVEs in image scans despite not
# being FluidSender dependencies — remove the whole thing.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder /app/.output ./.output

EXPOSE 3000
ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
