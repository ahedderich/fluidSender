FROM oven/bun:latest AS builder
WORKDIR /app

# Build tools needed by node-gyp to compile @serialport/bindings-cpp native addon
RUN apt-get update -y && apt-get install -y python3 make g++ --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

FROM node:22-slim AS runner
WORKDIR /app

# udev provides `udevadm`, which @serialport/bindings-cpp shells out to on
# Linux to list serial ports (SerialPort.list()); without it the port list
# request fails.
RUN apt-get update -y && apt-get install -y udev --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.output ./.output

EXPOSE 3000
ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
