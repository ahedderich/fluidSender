{
  "name": "fluidsender-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:server": "node_modules/.bin/esbuild tests/server/**/*.test.ts --bundle --platform=node --target=node18 --outdir=.test-out/ && node --test .test-out/*.js",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@types/three": "^0.184.1",
    "@vueuse/core": "^14.3.0",
    "expr-eval": "^2.0.2",
    "nuxt": "^4.4.8",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/vite": "^4.3.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "vitest": "^4.1.9"
  }
}
